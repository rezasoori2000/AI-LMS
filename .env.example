# =============================================================
# AI-LMS — .env.example
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the repo root
#   2. Fill in real values for your local environment
#   3. NEVER commit the .env file — it is in .gitignore
#   4. NEVER put real secrets in this file
#
# NAMING CONVENTION:
#   <SERVICE>_<CATEGORY>_<NAME>
#   All values are SCREAMING_SNAKE_CASE
# =============================================================


# =============================================================
# GENERAL / PLATFORM
# =============================================================

# Platform environment: development | staging | production
APP_ENV=development

# Default UI language (ISO 639-1 code)
APP_DEFAULT_LANGUAGE=en

# Default text direction: ltr | rtl
APP_DEFAULT_DIRECTION=ltr

# Platform base URL (used in emails, links)
APP_BASE_URL=http://localhost:5173


# =============================================================
# FRONTEND
# =============================================================

# Vite dev server port
FRONTEND_PORT=5173

# Base URL of the backend API (consumed by frontend)
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL of the AI service (if frontend calls AI service directly — Phase 2+)
# VITE_AI_SERVICE_URL=http://localhost:8000

# Feature flags (comma-separated, future use)
# VITE_FEATURE_FLAGS=


# =============================================================
# BACKEND (ASP.NET Core)
# =============================================================

# HTTP port for the backend API
BACKEND_PORT=5000

# ASP.NET Core environment
BACKEND_ASPNETCORE_ENVIRONMENT=Development

# JWT settings (fill with real secrets, never commit)
BACKEND_JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
BACKEND_JWT_ISSUER=ai-lms
BACKEND_JWT_AUDIENCE=ai-lms-clients
BACKEND_JWT_EXPIRY_MINUTES=60

# CORS — allowed frontend origin(s)
BACKEND_CORS_ORIGINS=http://localhost:5173


# =============================================================
# DATABASE (PostgreSQL)
# =============================================================

# Used by the backend and EF Core migrations
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ailms_dev
DB_USER=ailms_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Full connection string (built from above or set directly)
# BACKEND_DB_CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}


# =============================================================
# AI SERVICE (Python FastAPI)
# =============================================================

# HTTP port for the AI service
AI_SERVICE_PORT=8000

# AI service environment
AI_ENV=development

# Default AI provider: openai | azure_openai | anthropic | gemini | ollama
AI_DEFAULT_PROVIDER=ollama

# --- OpenAI ---
AI_OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
AI_OPENAI_MODEL=gpt-4o

# --- Azure OpenAI ---
# AI_AZURE_OPENAI_API_KEY=REPLACE_WITH_AZURE_KEY
# AI_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AI_AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AI_AZURE_OPENAI_API_VERSION=2024-02-01

# --- Anthropic ---
# AI_ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
# AI_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Google Gemini ---
# AI_GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
# AI_GEMINI_MODEL=gemini-1.5-pro

# --- Ollama (local) ---
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2


# =============================================================
# TENANT (runtime — Phase 3+)
# =============================================================

# Default tenant identifier for local single-tenant development
# TENANT_DEFAULT_ID=local-dev-tenant

# Tenant resolution strategy: header | subdomain | path (Phase 3)
# TENANT_RESOLUTION_STRATEGY=header


# =============================================================
# SEARCH (Phase 2+)
# =============================================================

# Elasticsearch / OpenSearch
# SEARCH_HOST=http://localhost:9200
# SEARCH_INDEX_PREFIX=ailms

# Vector store (pgvector, Qdrant, etc.)
# VECTOR_STORE_TYPE=pgvector
# VECTOR_STORE_URL=


# =============================================================
# MESSAGING (Phase 3+)
# =============================================================

# RabbitMQ / Kafka
# MESSAGING_HOST=localhost
# MESSAGING_PORT=5672
# MESSAGING_USER=ailms
# MESSAGING_PASSWORD=REPLACE_WITH_STRONG_PASSWORD


# =============================================================
# MONITORING / OBSERVABILITY (Phase 3+)
# =============================================================

# OpenTelemetry collector endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry DSN (error tracking)
# SENTRY_DSN=


# =============================================================
# EMAIL (Phase 2+)
# =============================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM_NAME=AI-LMS Platform
# SMTP_FROM_EMAIL=no-reply@example.com


# =============================================================
# STORAGE / FILE UPLOADS (Phase 2+)
# =============================================================

# LOCAL | S3 | AZURE_BLOB
# STORAGE_PROVIDER=LOCAL
# STORAGE_LOCAL_PATH=/data/uploads

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
