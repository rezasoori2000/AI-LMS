# =============================================================
# AI-LMS — .gitignore
# Covers: Node/React, .NET/C#, Python, Docker, IDE, OS files
# =============================================================

# -------------------------------------------------------------
# SECRETS — NEVER COMMIT
# -------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets/
**/secrets/

# -------------------------------------------------------------
# NODE / FRONTEND
# -------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache
.eslintcache
.stylelintcache
.parcel-cache
.turbo

# -------------------------------------------------------------
# .NET / C# BACKEND
# -------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.nupkg
*.snupkg
*.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets
_ReSharper*/
*.DotSettings.user
TestResults/
coverage/
*.coverage
*.coveragexml

# EF Core Migrations (keep migrations, ignore snapshots if needed)
# Uncomment below ONLY if you want to exclude migration snapshots:
# **/Migrations/*Snapshot.cs

# Publish output
publish/
**/publish/

# -------------------------------------------------------------
# PYTHON / AI SERVICE
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
dist/
build/
.eggs/
.tox/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.xml

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Jupyter
.ipynb_checkpoints

# AI / ML artifacts (keep models out of git)
*.gguf
*.bin
*.onnx
models/
embeddings/
vector_stores/

# -------------------------------------------------------------
# DOCKER
# -------------------------------------------------------------
docker-compose.override.yml
# (keep docker-compose.yml but override is developer-local)

# -------------------------------------------------------------
# IDE — VS Code
# -------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# -------------------------------------------------------------
# IDE — JetBrains (Rider, PyCharm, WebStorm)
# -------------------------------------------------------------
.idea/
*.iml
*.iws
out/

# -------------------------------------------------------------
# OS FILES
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -------------------------------------------------------------
# LOGS & TEMP
# -------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# -------------------------------------------------------------
# UPLOADS & USER CONTENT (never commit user data)
# -------------------------------------------------------------
uploads/
media/

# -------------------------------------------------------------
# CERTIFICATES (local dev TLS)
# -------------------------------------------------------------
*.crt
*.cer
