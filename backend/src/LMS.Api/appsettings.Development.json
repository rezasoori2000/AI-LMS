{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    // Local dev: matches the postgres service defined in docker-compose.override.yml
    // Run: docker compose up postgres  (or docker compose up)
    // Override with dotnet user-secrets: dotnet user-secrets set ConnectionStrings:Default "<conn>"
    "Default": "Host=localhost;Port=5432;Database=lms_dev;Username=lms;Password=lms"
  },
  "Jwt": {
    // DEV-ONLY key — never use in staging or production.
    // Replace with a strong random secret via: dotnet user-secrets set Jwt:SecretKey "<random>"
    "SecretKey": "dev-only-lms-jwt-secret-key-min32chars!",
    "Issuer": "http://localhost:5000",
    "Audience": "http://localhost:5173",
    "ExpiryMinutes": 60
  }
}
