{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // Populated per environment. Never use ["*"] in production.
    "AllowedOrigins": []
  },
  "Jwt": {
    // SecretKey MUST be supplied via environment variable or secrets manager in all environments.
    // In production use: Jwt__SecretKey environment variable (double-underscore = nested key).
    // Minimum 32 characters (256 bits) for HS256.
    // Never commit a real key to source control.
    "SecretKey": "",
    "Issuer": "https://api.ai-lms.com",
    "Audience": "https://app.ai-lms.com",
    "ExpiryMinutes": 60
  }
}
