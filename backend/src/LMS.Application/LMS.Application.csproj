<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LMS.Domain\LMS.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for IOptions<T> in AuthService constructor -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.*" />
    <!-- Required for DbSet<T> (ILmsDbContext) and async LINQ (ToListAsync, etc.)
         used by Application services that query via ILmsDbContext.
         Accepted pragmatic trade-off: Application is EF-aware but never creates
         contexts, configures models, or references Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
